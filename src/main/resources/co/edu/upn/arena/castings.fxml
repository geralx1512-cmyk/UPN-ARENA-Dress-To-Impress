<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox fx:id="raizCastings"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="co.edu.upn.arena.CastingsController"
      styleClass="pagina"
      spacing="10">

    <Label text="Castings" styleClass="titulo"/>

    <Label text="Cuadro de Castings:" styleClass="subtitulo"/>
    <TableView fx:id="tblCastingsInfo" prefHeight="130" maxHeight="130">
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
        </columnResizePolicy>
        <columns>
            <TableColumn fx:id="colCastingNombre" text="Casting"/>
            <TableColumn fx:id="colCastingModalidad" text="Modalidad"/>
            <TableColumn fx:id="colCastingCupos" text="Cupos disponibles"/>
        </columns>
    </TableView>

    <VBox spacing="5">
        <Label text="Selecciona tu grupo:" styleClass="subtitulo"/>
        <ComboBox fx:id="cmbGrupos" prefWidth="280"/>
    </VBox>

    <HBox spacing="10">
        <Button text="Audicionar" styleClass="boton-principal" onAction="#audicionar"/>
    </HBox>

    <Label text="Horarios asignados:" styleClass="subtitulo"/>
    <TableView fx:id="tblAudiciones" prefHeight="200">
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
        </columnResizePolicy>
        <columns>
            <TableColumn fx:id="colAudGrupo" text="Grupo"/>
            <TableColumn fx:id="colAudCasting" text="Casting"/>
            <TableColumn fx:id="colAudHorario" text="Horario"/>
        </columns>
    </TableView>

</VBox>