<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox fx:id="raizGrupos"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="co.edu.upn.arena.GruposController"
      styleClass="pagina"
      spacing="10">

    <Label text="Grupos" styleClass="titulo"/>

    <Label text="Nombre del Equipo:" styleClass="subtitulo"/>
    <TextField fx:id="txtNombre" promptText="Ej. FLO o Nombre del participante"/>

    <Label text="Modalidad:" styleClass="subtitulo"/>
    <HBox spacing="15">
        <fx:define>
            <ToggleGroup fx:id="grupoModalidad"/>
        </fx:define>
        <RadioButton fx:id="rbSolo" text="Solo" toggleGroup="$grupoModalidad" selected="true" onAction="#actualizarModalidad"/>
        <RadioButton fx:id="rbDuo" text="Duo" toggleGroup="$grupoModalidad" onAction="#actualizarModalidad"/>
        <RadioButton fx:id="rbTrio" text="Trio" toggleGroup="$grupoModalidad" onAction="#actualizarModalidad"/>
    </HBox>

    <Label text="Integrantes (escoger de modelos disponibles):" styleClass="subtitulo"/>
    <ComboBox fx:id="cmbInt1" promptText="1. Integrante" prefWidth="320" onAction="#actualizarOpcionesIntegrantes"/>
    <ComboBox fx:id="cmbInt2" promptText="2. Integrante" prefWidth="320" onAction="#actualizarOpcionesIntegrantes"/>
    <ComboBox fx:id="cmbInt3" promptText="3. Integrante" prefWidth="320"/>

    <HBox spacing="10">
        <Button text="Guardar" styleClass="boton-principal" onAction="#guardarGrupo"/>
        <Button text="Eliminar" styleClass="boton-peligro" onAction="#eliminarGrupo"/>
    </HBox>

    <Label text="Resumen:" styleClass="subtitulo"/>
    <TableView fx:id="tblGrupos" prefHeight="150">
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
        </columnResizePolicy>
        <columns>
            <TableColumn fx:id="colNombre" text="Equipo"/>
            <TableColumn fx:id="colModalidad" text="Modalidad"/>
            <TableColumn fx:id="colIntegrantes" text="Integrantes"/>
        </columns>
    </TableView>

</VBox>