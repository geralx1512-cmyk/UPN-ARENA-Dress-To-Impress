<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.String?>
<?import javafx.collections.FXCollections?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<HBox fx:id="raizModelos"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="co.edu.upn.arena.ModelosController"
      styleClass="pagina"
      spacing="20">

    <VBox spacing="10" HBox.hgrow="ALWAYS">
        <Label text="Modelos" styleClass="titulo"/>

        <Label text="Nombre:" styleClass="subtitulo"/>
        <TextField fx:id="txtNombre" promptText="Ej. Alessandro Rivero"/>

        <Label text="Alias:" styleClass="subtitulo"/>
        <TextField fx:id="txtAlias" promptText="Ej. Aless Riv"/>

        <Label text="Correo:" styleClass="subtitulo"/>
        <TextField fx:id="txtCorreo" promptText="Ej. aless.riv.13@gmail.com"/>

        <Label text="Género:" styleClass="subtitulo"/>
        <ComboBox fx:id="cmbGenero" prefWidth="220">
            <items>
                <FXCollections fx:factory="observableArrayList">
                    <String fx:value="Male"/>
                    <String fx:value="Female"/>
                    <String fx:value="Inbetween"/>
                    <String fx:value="None"/>
                </FXCollections>
            </items>
        </ComboBox>

        <HBox spacing="10">
            <Button text="Guardar" styleClass="boton-principal" onAction="#guardarModelo"/>
            <Button text="Eliminar" styleClass="boton-peligro" onAction="#eliminarModelo"/>
        </HBox>

        <Label text="Resumen:" styleClass="subtitulo"/>
        <TableView fx:id="tblModelos" prefHeight="180">
            <columns>
                <TableColumn fx:id="colNombre" text="Nombre" prefWidth="150"/>
                <TableColumn fx:id="colAlias" text="Alias" prefWidth="120"/>
                <TableColumn fx:id="colCorreo" text="Correo" prefWidth="180"/>
                <TableColumn fx:id="colGenero" text="Género" prefWidth="110"/>
            </columns>
        </TableView>
    </VBox>

    <VBox fx:id="panelModo" spacing="40" prefWidth="220" styleClass="panel-modo">
        <ImageView fx:id="imgPersonaje" fitWidth="220" fitHeight="600" preserveRatio="true"/>
    </VBox>

</HBox>